# ─────────────────────────────────────────────────────────────────────────────
# Data paths (defaults point at ./data mount — same as docker-compose volume)
# ─────────────────────────────────────────────────────────────────────────────
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# ─────────────────────────────────────────────────────────────────────────────
# Date override — useful for testing against fixed dates
# Leave empty to use the system date
# ─────────────────────────────────────────────────────────────────────────────
APP_TODAY=

# ─────────────────────────────────────────────────────────────────────────────
# LLM provider
#   openai | anthropic | google | groq | openai_compatible
# openai_compatible = ANY OpenAI-compatible endpoint (xAI Grok, OpenRouter,
# Together, Ollama, vLLM, …) — set LLM_BASE_URL and LLM_MODEL below.
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai

# Leave empty to use the provider default model (see src/config.py):
#   openai → gpt-6-luna | anthropic → claude-haiku-4-5-20251001
#   google → gemini-3.5-flash-lite | groq → openai/gpt-oss-120b
LLM_MODEL=

# Custom base URL for an OpenAI-compatible API. Examples:
#   xAI Grok     https://api.x.ai/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Ollama       http://localhost:11434/v1
# Leave empty for the built-in provider defaults.
LLM_BASE_URL=

# Temperature 0 = maximum consistency across test runs
LLM_TEMPERATURE=0

# Per-attempt LLM timeout, retries, and the hard per-request ceiling (seconds).
# The request ceiling must stay under the task's 30-second limit.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0
REQUEST_TIMEOUT_SECONDS=25

# Transient throttling (HTTP 429 / "rate limit reached") handling. One short
# in-request retry keeps the response inside the 30-second budget; the wait is
# capped by LLM_RATE_LIMIT_MAX_SLEEP. Free provider tiers rate-limit on
# tokens-per-minute, so the EVAL harness also paces its own requests
# (see eval/README.md: --delay / --retries).
LLM_RATE_LIMIT_RETRIES=1
LLM_RATE_LIMIT_MAX_SLEEP=8

# ─────────────────────────────────────────────────────────────────────────────
# API keys — fill in the key for your chosen LLM_PROVIDER
# NEVER commit real keys to git
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# Key used only when LLM_PROVIDER=openai_compatible (falls back to OPENAI_API_KEY)
LLM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# RAG / retrieval tuning
# ─────────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=30                 # Candidates from FAISS + BM25 before filtering
CORPUS_TOKEN_BUDGET=3000           # Max corpus tokens per LLM call (task limit)
CONFIDENCE_THRESHOLD=0.30          # Below this → no_answer without an LLM call
CACHE_TTL_SECONDS=604800           # Semantic answer cache TTL (seconds, 7 days)
SEMANTIC_CACHE_ENABLED=true        # false = never reuse a stored answer (cold run)
SEMANTIC_CACHE_THRESHOLD=0.93      # Min cosine similarity to reuse a stored answer
SEMANTIC_CACHE_MAX_ENTRIES=500     # Bound on locally stored answers

# ─────────────────────────────────────────────────────────────────────────────
# Ingestion integrity checks
# ─────────────────────────────────────────────────────────────────────────────
MIN_PAGE_CHARS=200                 # Pages below this are OCR-retried, else flagged
MIN_DOCUMENT_CHARS=200             # Documents below this are flagged

# ─────────────────────────────────────────────────────────────────────────────
# Embedding — local CPU model, no API key needed
# ─────────────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─────────────────────────────────────────────────────────────────────────────
# Vector store persistence
# ─────────────────────────────────────────────────────────────────────────────
VECTOR_STORE_DIR=./vector_store

# ─────────────────────────────────────────────────────────────────────────────
# Testing / API-only mode — set to true to skip startup ingestion.
# Leave commented out in the evaluated container so /health waits for a real index.
# ─────────────────────────────────────────────────────────────────────────────
# SKIP_INGESTION=false
